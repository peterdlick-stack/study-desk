{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course transcript generation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["translations", "notes", "map"],
  "properties": {
    "translations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12000,
      "items": { "$ref": "#/$defs/translation" }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4000,
      "items": { "$ref": "#/$defs/note" }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1500,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "maxItems": 4000,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    }
  },
  "$defs": {
    "reviewStatus": {
      "type": "string",
      "enum": ["needs-review", "UNKNOWN"]
    },
    "generatedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "cueId": {
      "type": "string",
      "pattern": "^cue-[0-9]{6}$"
    },
    "evidenceCueIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cueId" }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cueId", "translatedText", "reviewStatus"],
      "properties": {
        "cueId": { "$ref": "#/$defs/cueId" },
        "translatedText": { "type": "string", "minLength": 1 },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "themeId",
        "themeTitle",
        "evidenceCueIds",
        "reviewStatus"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/generatedId" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "themeId": { "$ref": "#/$defs/generatedId" },
        "themeTitle": { "type": "string", "minLength": 1 },
        "evidenceCueIds": { "$ref": "#/$defs/evidenceCueIds" },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "parentId", "evidenceCueIds", "reviewStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/generatedId" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["course", "topic", "concept", "formula", "example", "warning", "UNKNOWN"]
        },
        "parentId": {
          "anyOf": [
            { "$ref": "#/$defs/generatedId" },
            { "type": "null" }
          ]
        },
        "evidenceCueIds": { "$ref": "#/$defs/evidenceCueIds" },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relation", "evidenceCueIds", "reviewStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/generatedId" },
        "from": { "$ref": "#/$defs/generatedId" },
        "to": { "$ref": "#/$defs/generatedId" },
        "relation": {
          "type": "string",
          "enum": [
            "part-of",
            "explains",
            "derives",
            "applies",
            "contrasts",
            "requires",
            "example-of",
            "related-to",
            "UNKNOWN"
          ]
        },
        "evidenceCueIds": { "$ref": "#/$defs/evidenceCueIds" },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" }
      }
    }
  }
}
